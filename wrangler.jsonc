{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "suketto-court",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-27",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "suketto-court.yhay81.com",
      "custom_domain": true,
    },
  ],
  "triggers": {
    "crons": ["23 18 * * *"],
  },
  "observability": {
    "enabled": true,
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "suketto-court",
      "database_id": "22f6e451-c3b5-4ee6-9a68-951fe0a48910",
      "migrations_dir": "migrations",
    },
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
  },
}
